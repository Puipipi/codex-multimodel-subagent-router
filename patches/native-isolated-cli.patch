+                "type": "namespace", "name": "collaboration", "description": "canonical",
+                "tools": [
+                    {"type": "function", "name": "spawn_agent", "description": "spawn", "parameters": {"type": "object", "properties": {"message": {"type": "string", "encrypted": true}, "other": {"type": "string", "encrypted": true}}}},
+                    {"type": "function", "name": "send_message", "parameters": {"type": "object", "properties": {"message": {"type": "string", "encrypted": true}}}},
+                    {"type": "function", "name": "followup_task", "parameters": {"type": "object", "properties": {"message": {"type": "string", "encrypted": true}}}}
+                ]
+            },
+            {"type": "function", "name": "unrelated", "description": "unchanged", "parameters": {"type": "object", "properties": {"message": {"type": "string", "encrypted": true}}}}
+        ])
+    }
+
+    #[test]
+    fn encodes_namespace_tools_and_only_removes_collaboration_message_encryption_markers() {
+        let encoded = encode_tools_json(collaboration_tools()).expect("encode collaboration namespace");
+        assert_eq!(encoded[0]["name"], WIRE_NAMESPACE);
+        assert_eq!(encoded[0]["tools"][0]["name"], "start_delegated_task");
+        assert_eq!(encoded[0]["tools"][1]["name"], "deliver_delegated_message");
+        assert_eq!(encoded[0]["tools"][2]["name"], "continue_delegated_task");
+        assert!(encoded[0]["tools"][0]["parameters"]["properties"]["message"]["encrypted"].is_null());
+        assert_eq!(encoded[0]["tools"][0]["parameters"]["properties"]["other"]["encrypted"], true);
+        assert_eq!(encoded[1]["name"], "unrelated");
+        assert_eq!(encoded[1]["parameters"]["properties"]["message"]["encrypted"], true);
+    }
+
+    #[test]
+    fn flattened_tool_names_encode_and_decode_idempotently() {
+        let flattened = json!([{"type":"function","name":"collaboration.spawn_agent","parameters":{"type":"object","properties":{"message":{"type":"string","encrypted":true}}}}]);
+        let encoded = encode_tools_json(flattened).expect("encode flattened function");
+        assert_eq!(encoded[0]["name"], "collaboration-optimize.start_delegated_task");
+        assert!(encoded[0]["parameters"]["properties"]["message"]["encrypted"].is_null());
+        let again = encode_tools_json(encoded.clone()).expect("idempotent encode");
+        assert_eq!(again, encoded);
+        assert_eq!(transform_tools(encoded, Direction::Decode).expect("decode flattened"), json!([{"type":"function","name":"collaboration.spawn_agent","parameters":{"type":"object","properties":{"message":{"type":"string"}}}}]));
+    }
+
+    #[test]
+    fn flattened_non_alias_collaboration_tools_keep_the_function_name() {
+        let flattened = json!([{"type":"function","name":"collaboration.list_agents","parameters":{"type":"object","properties":{"message":{"type":"string","encrypted":true}}}}]);
+        let encoded = encode_tools_json(flattened).expect("encode flattened collaboration tool");
+        assert_eq!(encoded[0]["name"], "collaboration-optimize.list_agents");
+        assert_eq!(encoded[0]["parameters"]["properties"]["message"]["encrypted"], true);
+        let decoded = transform_tools(encoded, Direction::Decode).expect("decode flattened collaboration tool");
+        assert_eq!(decoded[0]["name"], "collaboration.list_agents");
+    }
+
+    #[test]
+    fn explicit_unrelated_namespace_prevents_flat_name_reinterpretation() {
+        let tools = json!([{"type":"function","namespace":"external","name":"collaboration.spawn_agent"}]);
+        let encoded = encode_tools_json(tools.clone()).expect("encode unrelated namespaced tool");
+        assert_eq!(encoded, tools);
+    }
+
+    #[test]
+    fn flattened_canonical_and_wire_alias_names_collide() {
+        let tools = json!([
+            {"type":"function","name":"collaboration.spawn_agent"},
+            {"type":"function","name":"collaboration-optimize.start_delegated_task"}
+        ]);
+        assert!(encode_tools_json(tools).is_err());
+    }
+
+    #[test]
+    fn namespace_alias_collision_is_an_error() {
+        let tools = json!([
+            {"type":"namespace","name":"collaboration","tools":[]},
+            {"type":"namespace","name":"collaboration-optimize","tools":[]}
+        ]);
+        assert!(encode_tools_json(tools).is_err());
+    }
+
+    #[test]
+    fn typed_function_call_round_trips_without_changing_call_data() {
+        let mut item: ResponseItem = serde_json::from_value(json!({
+            "type": "function_call", "id": "fc-item", "call_id": "call-123",
+            "name": "spawn_agent", "namespace": "collaboration",
+            "arguments": "{\"message\":\"fixture\"}", "status": "completed",
+            "encrypted_function_args": ["opaque"]
+        })).expect("deserialize typed function call");
+        encode_response_item(&mut item).expect("encode typed item");
+        let wire = serde_json::to_value(&item).expect("serialize wire item");
+        assert_eq!(wire["namespace"], WIRE_NAMESPACE);
+        assert_eq!(wire["name"], "start_delegated_task");
+        assert_eq!(wire["arguments"], "{\"message\":\"fixture\"}");
+        assert_eq!(wire["call_id"], "call-123");
+        assert_eq!(wire["id"], "fc-item");
+        decode_response_item(&mut item).expect("decode typed item");
+        assert_eq!(serde_json::to_value(item).expect("serialize canonical item"), json!({
+            "type": "function_call", "id": "fc-item", "call_id": "call-123",
+            "name": "spawn_agent", "namespace": "collaboration",
+            "arguments": "{\"message\":\"fixture\"}", "status": "completed",
+            "encrypted_function_args": ["opaque"]
+        }));
+    }
+
+    #[test]
+    fn additional_tools_items_use_the_same_encoder_and_decoder() {
+        let mut item: ResponseItem = serde_json::from_value(json!({
+            "type":"additional_tools", "role":"developer", "tools": collaboration_tools()
+        })).expect("deserialize additional tools");
+        encode_response_item(&mut item).expect("encode additional tools");
+        let wire = serde_json::to_value(&item).expect("serialize wire tools");
+        assert_eq!(wire["tools"][0]["name"], WIRE_NAMESPACE);
+        decode_response_item(&mut item).expect("decode additional tools");
+        let canonical = serde_json::to_value(item).expect("serialize canonical tools");
+        assert_eq!(canonical["tools"][0]["name"], SOURCE_NAMESPACE);
+        assert_eq!(canonical["tools"][0]["tools"][0]["name"], "spawn_agent");
+        assert!(canonical["tools"][0]["tools"][0]["parameters"]["properties"]["message"]["encrypted"].is_null());
+        assert_eq!(canonical["tools"][0]["tools"][0]["parameters"]["properties"]["other"]["encrypted"], true);
+        assert_eq!(canonical["tools"][1]["parameters"]["properties"]["message"]["encrypted"], true);
+    }
+}
