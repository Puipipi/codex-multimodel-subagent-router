+use crate::config::Config;
+use codex_protocol::openai_models::ModelsResponse;
+use std::fs;
+
+pub(crate) const NATIVE_DEEPSEEK_ROLE_NAME: &str = "native_deepseek";
+pub(crate) const NATIVE_DEEPSEEK_PROVIDER_ID: &str = "deepseek-native";
+pub(crate) const NATIVE_DEEPSEEK_MODEL: &str = "deepseek/deepseek-flash";
+pub(crate) const NATIVE_DEEPSEEK_CATALOG_FILE: &str = "sol-luna-native-models.json";
+
+pub(crate) fn apply_native_deepseek_child_config(
+    config: &mut Config,
+    role_name: Option<&str>,
+    full_history_fork: bool,
+) -> Result<(), String> {
+    if role_name != Some(NATIVE_DEEPSEEK_ROLE_NAME) {
+        return Ok(());
+    }
+    if full_history_fork {
+        return Err("native_deepseek child does not support full-history forks".to_string());
+    }
+
+    let model = config.model.as_deref();
+    if model != Some(NATIVE_DEEPSEEK_MODEL) {
+        return Err(format!(
+            "native_deepseek role requires model `{NATIVE_DEEPSEEK_MODEL}`, got `{}`",
+            model.unwrap_or("<unset>")
+        ));
+    }
+
+    if let Some(required_provider) = config.config_layer_stack.required_model_provider()
+        && required_provider != NATIVE_DEEPSEEK_PROVIDER_ID
+    {
+        return Err(format!(
+            "native_deepseek child requires provider `{NATIVE_DEEPSEEK_PROVIDER_ID}`, but managed configuration requires `{required_provider}`"
+        ));
+    }
+
+    let provider = config
+        .model_providers
+        .get(NATIVE_DEEPSEEK_PROVIDER_ID)
+        .cloned()
+        .ok_or_else(|| {
+            format!(
+                "native_deepseek provider `{NATIVE_DEEPSEEK_PROVIDER_ID}` is not configured"
+            )
+        })?;
+    let catalog_path = config
+        .codex_home
+        .as_path()
+        .join(NATIVE_DEEPSEEK_CATALOG_FILE);
+    let bytes = fs::read(&catalog_path).map_err(|err| {
+        format!(
+            "failed to read native_deepseek child model catalog `{}`: {err}",
+            catalog_path.display()
+        )
+    })?;
+    let catalog: ModelsResponse = serde_json::from_slice(&bytes).map_err(|err| {
+        format!(
+            "failed to parse native_deepseek child model catalog `{}`: {err}",
+            catalog_path.display()
+        )
+    })?;
+    if !catalog.models.iter().any(|entry| entry.slug == NATIVE_DEEPSEEK_MODEL) {
+        return Err(format!(
+            "native_deepseek child model catalog must include `{NATIVE_DEEPSEEK_MODEL}`"
+        ));
+    }
+    if let Some(reasoning_effort) = config.model_reasoning_effort.as_ref() {
+        let model = catalog
+            .models
+            .iter()
+            .find(|entry| entry.slug == NATIVE_DEEPSEEK_MODEL)
+            .expect("catalog model was checked above");
+        if !model
+            .supported_reasoning_levels
+            .iter()
+            .any(|preset| &preset.effort == reasoning_effort)
+        {
+            let supported = model
+                .supported_reasoning_levels
+                .iter()
+                .map(|preset| preset.effort.to_string())
+                .collect::<Vec<_>>()
+                .join(", ");
+            return Err(format!(
+                "Reasoning effort `{reasoning_effort}` is not supported for model `{NATIVE_DEEPSEEK_MODEL}` in the native child catalog. Supported reasoning efforts: {supported}"
+            ));
+        }
+    }
+
+    config.model_provider_id = NATIVE_DEEPSEEK_PROVIDER_ID.to_string();
+    config.model_provider = provider;
+    config.model_catalog = Some(catalog);
+    Ok(())
+}
